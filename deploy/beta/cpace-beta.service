[Unit]
Description=1Cpace V8 (Beta)
After=network.target

[Service]
User=cpace
Group=cpace
WorkingDirectory=/opt/cpace-beta

# PORT is set here rather than only in .env because gunicorn.conf.py reads it
# at config-load time, before the app runs load_dotenv(). Production holds 5000.
Environment=PORT=5001
EnvironmentFile=/opt/cpace-beta/.env

ExecStart=/opt/cpace-beta/venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=always
RestartSec=5

# Beta shares a host with production, so keep it out of production's files.
# /var/data/cpace-beta holds beta's databases; /opt/cpace-beta/uploads holds
# member documents. Nothing else on the box needs to be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/data/cpace-beta /opt/cpace-beta/uploads /opt/cpace-beta/logs

# Deliberately NOT set: ProtectHome, PrivateDevices, MemoryDenyWriteExecute.
# The NuPay and Itensity drivers launch Playwright's Chromium, which needs a
# writable browser cache and a JIT-capable mapping; those three break it.

[Install]
WantedBy=multi-user.target
