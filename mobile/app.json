{
  "expo": {
    "name": "1Cpace",
    "slug": "onecpase-mobile",
    "version": "1.1.0",
    "scheme": "onecpase",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onecpase.mobile"
    },
    "android": {
      "package": "com.onecpase.mobile",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "backgroundColor": "#002e45",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-router",
      "./plugins/with-workspace-android"
    ]
  }
}
