# Flask
SECRET_KEY=change-me

# Multi-tenant platform: registry of gyms on this install, and where new
# tenant databases are created. Leave commented out to use the defaults
# (platform.db and tenants/, both next to 1cpase.db).
# DATABASE_PATH must name the same file the tenant registry records for this
# gym, or anything resolving outside a tenant-bound request (the turnstile
# monitor, the bare PBX webhook) writes to a different database.
# DATABASE_PATH=data/tenants/elev8.db
# Binds this installation's USB turnstile monitor to one registered tenant.
# TURNSTILE_TENANT_SLUG=elev8
# PLATFORM_DATABASE_PATH=platform.db
# TENANTS_DIR=tenants
#
# Used once by `python seed_platform_admin.py` to create the operator
# account that can add/manage gyms at /platform. Not read by the app itself.
# PLATFORM_ADMIN_USERNAME=owner
# PLATFORM_ADMIN_PASSWORD=change-me

# Itensity member API (leave blank to disable)
ITENSITY_API_URL=
ITENSITY_API_KEY=
ITENSITY_MEMBER_PATH=/members
ITENSITY_TIMEOUT=10

# NuPay DebiCheck mandate push — merchant.nupay.co.za (Playwright + TOTP)
NUPAY_MERCHANT_ID=000025500014054
NUPAY_NEW_EMAIL=your_merchant_portal_email
NUPAY_NEW_PASSWORD=your_merchant_portal_password
NUPAY_TOTP_SECRET=your_google_authenticator_base32_secret
NUPAY_NEW_ACCESS_ID=000025500014054
NUPAY_NEW_ACCESS_TYPE=M
NUPAY_NEW_HEADED=0
NUPAY_NEW_AUTH_REQUIRED=0227

# Used only by the Itensity member push (still the sibling app's driver).
# Optional when RADEPULSE is not beside 1Cpase:
RADEPULSE_PATH=

# WhatsApp Business (Meta Graph API) + Facebook Messenger/comments.
# Leave blank to keep Communications structurally present but inert.
WA_TOKEN=
WA_VERIFY_TOKEN=elev8_wa_verify
WA_RECEPTION_PHONE_ID=
WA_SALES_PHONE_ID=
WA_RECEPTION_DISPLAY=
WA_SALES_DISPLAY=
FB_APP_SECRET=
FB_VERIFY_TOKEN=elev8_fb_verify
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Call-list OCR. Only needed if Tesseract isn't discoverable on PATH —
# otherwise the default Windows install location is used automatically.
TESSERACT_CMD=

# USB HID turnstile
TURNSTILE_ENABLED=0
TURNSTILE_VENDOR_ID=4825
TURNSTILE_PRODUCT_ID=8701
# Keep disabled until the controller's unlock protocol is confirmed.
TURNSTILE_OUTPUT_ENABLED=0

# Yeastar P-Series PBX (click-to-call + CDR). Leave CLIENT_ID/CLIENT_SECRET
# blank to keep the integration inert: /pbx/dial and /pbx/webhook stay
# mounted but fail with a clear "not configured" message. Client ID and
# Secret come from Yeastar > Integrations > API. Never expose the secret to
# browser JavaScript — see PBX_INTEGRATION.md.
PBX_BASE_URL=https://pbx.yeastarycm.co.za
PBX_API_VERSION=openapi/v1.0
PBX_CLIENT_ID=
PBX_CLIENT_SECRET=
# Fallback caller extension when the 1Cpace user has no pbx_extension set.
PBX_DEFAULT_EXTENSION=
# Optional: restrict dialling to a single permitted extension.
PBX_DIAL_PERMISSION=
# Shared secret for /pbx/webhook. Optional in dev, required in production.
PBX_WEBHOOK_SECRET=
PBX_TIMEOUT=10
